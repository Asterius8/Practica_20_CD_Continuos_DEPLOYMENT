pipeline {
    agent any

    stages {
        stage('clone repository') {
            steps {
                bat '''
                    echo Verificando herramientas...
                    java -version
                    mvn --version
                    git --version
                    kubectl version --client
                '''
            }
        }

        stage('Deploy billing App') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'kubernetes-jenkis-server-account',
                        variable: 'api_token'
                    )
                ]) {
                    bat '''
                        @echo off
                        echo Verificando conexion con Kubernetes...

                        kubectl --token "%api_token%" --server https://127.0.0.1:55990 --insecure-skip-tls-verify=true get nodes

                        echo Aplicando manifiesto de Kubernetes...

                        kubectl --token "%api_token%" --server https://127.0.0.1:55990 --insecure-skip-tls-verify=true apply -f jenkins_kubernetes_CI_CD/deployment-billing-app-back-jenkins.yaml

                        echo Verificando deployments...
                        kubectl --token "%api_token%" --server https://127.0.0.1:55990 --insecure-skip-tls-verify=true get deployments
                    '''
                }
            }
        }
    }
}